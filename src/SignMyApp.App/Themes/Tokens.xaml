<!--
  Klarseal design tokens for WPF. Mirrors apps/web/src/styles/tokens.css (grayscale system, 2026-09-12):
  a grey ramp, ink as the primary action, four status hues carried by a 6 px dot and never alone.
  Light only. Added for the desktop app: Color.Backdrop (ink at 32 %) behind dialogs.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Grey ramp -->
    <Color x:Key="Color.Grey0">#FFFFFF</Color>
    <Color x:Key="Color.Grey25">#FAFAF9</Color>
    <Color x:Key="Color.Grey50">#F5F5F3</Color>
    <Color x:Key="Color.Grey100">#ECECE8</Color>
    <Color x:Key="Color.Grey200">#E3E3DE</Color>
    <Color x:Key="Color.Grey300">#D3D3CD</Color>
    <Color x:Key="Color.Grey400">#A3A39D</Color>
    <Color x:Key="Color.Grey500">#68686C</Color>
    <Color x:Key="Color.Grey600">#5C5C5E</Color>
    <Color x:Key="Color.Grey700">#4A4A4C</Color>
    <Color x:Key="Color.Grey900">#111112</Color>
    <Color x:Key="Color.PrimaryHover">#2E2E31</Color>

    <!-- Status: semantic only, always a dot plus words -->
    <Color x:Key="Color.Status.Action">#2C4BC9</Color>
    <Color x:Key="Color.Status.Success">#1F7A4D</Color>
    <Color x:Key="Color.Status.Warn">#8A5A00</Color>
    <Color x:Key="Color.Status.Danger">#B3261E</Color>
    <Color x:Key="Color.Status.Neutral">#68686C</Color>

    <!-- Added token: modal backdrop, ink #111112 at 32 % (0x52) -->
    <Color x:Key="Color.Backdrop">#52111112</Color>
    <Color x:Key="Color.Shadow">#111112</Color>

    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Grey0}" />
    <SolidColorBrush x:Key="Brush.Sunken" Color="{StaticResource Color.Grey25}" />
    <SolidColorBrush x:Key="Brush.Subtle" Color="{StaticResource Color.Grey50}" />
    <SolidColorBrush x:Key="Brush.Muted" Color="{StaticResource Color.Grey100}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Grey200}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.Grey300}" />
    <SolidColorBrush x:Key="Brush.Disabled" Color="{StaticResource Color.Grey400}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.Grey500}" />
    <SolidColorBrush x:Key="Brush.TextBody" Color="{StaticResource Color.Grey600}" />
    <SolidColorBrush x:Key="Brush.TextOnGrey" Color="{StaticResource Color.Grey700}" />
    <SolidColorBrush x:Key="Brush.Ink" Color="{StaticResource Color.Grey900}" />
    <SolidColorBrush x:Key="Brush.OnInk" Color="{StaticResource Color.Grey0}" />
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="{StaticResource Color.PrimaryHover}" />
    <SolidColorBrush x:Key="Brush.PrimaryPressed" Color="{StaticResource Color.Grey700}" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="{StaticResource Color.Grey900}" />
    <SolidColorBrush x:Key="Brush.Backdrop" Color="{StaticResource Color.Backdrop}" />

    <SolidColorBrush x:Key="Brush.Status.Action" Color="{StaticResource Color.Status.Action}" />
    <SolidColorBrush x:Key="Brush.Status.Success" Color="{StaticResource Color.Status.Success}" />
    <SolidColorBrush x:Key="Brush.Status.Warn" Color="{StaticResource Color.Status.Warn}" />
    <SolidColorBrush x:Key="Brush.Status.Danger" Color="{StaticResource Color.Status.Danger}" />
    <SolidColorBrush x:Key="Brush.Status.Neutral" Color="{StaticResource Color.Status.Neutral}" />

    <!-- Approved canvas v46, board 4.6: window edge and continuous grey chrome band. -->
    <Color x:Key="Window.BorderActiveColor">#D3D3CD</Color>
    <Color x:Key="Window.BorderInactiveColor">#E3E3DE</Color>
    <SolidColorBrush x:Key="Chrome.Background" Color="{StaticResource Color.Grey50}" />
    <SolidColorBrush x:Key="Chrome.Baseline" Color="{StaticResource Color.Grey200}" />
    <SolidColorBrush x:Key="Chrome.Pill" Color="{StaticResource Color.Grey0}" />
    <Thickness x:Key="Chrome.BaselineThickness">0,0,0,1</Thickness>
    <Thickness x:Key="Window.GlassFrameThickness">0,0,0,1</Thickness>
    <sys:Double x:Key="Window.BorderWidth">1</sys:Double>
    <sys:Double x:Key="FileRow.SelectionBarWidth">3</sys:Double>
    <sys:Double x:Key="TitleBar.Height">32</sys:Double>
    <sys:Double x:Key="TitleBar.ButtonWidth">46</sys:Double>
    <sys:Double x:Key="TitleBar.IconSize">16</sys:Double>
    <sys:Double x:Key="TitleBar.TextSize">12</sys:Double>
    <sys:Double x:Key="TitleBar.GlyphSize">10</sys:Double>
    <sys:Double x:Key="TitleBar.GlyphStroke">1</sys:Double>
    <Thickness x:Key="TitleBar.IconMargin">8,0,8,0</Thickness>
    <SolidColorBrush x:Key="TitleBar.Background" Color="{StaticResource Color.Grey50}" />
    <SolidColorBrush x:Key="TitleBar.Foreground" Color="{StaticResource Color.Grey900}" />
    <SolidColorBrush x:Key="TitleBar.Hover" Color="{StaticResource Color.Grey200}" />
    <SolidColorBrush x:Key="TitleBar.Pressed" Color="{StaticResource Color.Grey300}" />
    <SolidColorBrush x:Key="TitleBar.InactiveGlyph" Color="{StaticResource Color.Grey400}" />
    <SolidColorBrush x:Key="TitleBar.InactiveTitle" Color="{StaticResource Color.Grey500}" />
    <Color x:Key="TitleBar.CloseHoverColor">#C42B1C</Color>
    <Color x:Key="TitleBar.ClosePressedColor">#C84031</Color>
    <SolidColorBrush x:Key="TitleBar.CloseHover" Color="{StaticResource TitleBar.CloseHoverColor}" />
    <SolidColorBrush x:Key="TitleBar.ClosePressed" Color="{StaticResource TitleBar.ClosePressedColor}" />
    <SolidColorBrush x:Key="TitleBar.CloseForeground" Color="{StaticResource Color.Grey0}" />

    <!-- Type: embedded OFL Manrope, with Segoe UI fallback. Mono for paths, hashes, thumbprints. -->
    <FontFamily x:Key="Font.Sans">pack://application:,,,/SignMyApp;component/Fonts/#Manrope, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>

    <sys:Double x:Key="Text.2xs">10</sys:Double>
    <sys:Double x:Key="Text.Xs">12</sys:Double>
    <sys:Double x:Key="Text.Sm">13</sys:Double>
    <sys:Double x:Key="Text.Base">13.5</sys:Double>
    <sys:Double x:Key="Text.Row">14</sys:Double>
    <sys:Double x:Key="Text.Md">15.5</sys:Double>
    <sys:Double x:Key="Text.Dialog">17</sys:Double>
    <sys:Double x:Key="Text.Lg">21</sys:Double>
    <sys:Double x:Key="Text.H1Small">32</sys:Double>
    <sys:Double x:Key="Text.H1">42</sys:Double>

    <!-- Space: the 4 px scale -->
    <sys:Double x:Key="Space.3xs">4</sys:Double>
    <sys:Double x:Key="Space.2xs">8</sys:Double>
    <sys:Double x:Key="Space.Xs">12</sys:Double>
    <sys:Double x:Key="Space.Sm">16</sys:Double>
    <sys:Double x:Key="Space.Md">22</sys:Double>
    <sys:Double x:Key="Space.Lg">28</sys:Double>
    <sys:Double x:Key="Space.Xl">40</sys:Double>

    <!-- Thickness values on the approved spacing scale; two components mean horizontal/vertical; four mean left/top/right/bottom. The 1 px toolbar baseline is optical. -->
    <Thickness x:Key="Inset.0.0.0.12">0,0,0,12</Thickness>
    <Thickness x:Key="Inset.0.0.0.8">0,0,0,8</Thickness>
    <Thickness x:Key="Inset.0.0.12.0">0,0,12,0</Thickness>
    <Thickness x:Key="Inset.0.0.16.0">0,0,16,0</Thickness>
    <Thickness x:Key="Inset.0.0.22.0">0,0,22,0</Thickness>
    <Thickness x:Key="Inset.0.0.8.0">0,0,8,0</Thickness>
    <Thickness x:Key="Inset.0.0.8.8">0,0,8,8</Thickness>
    <Thickness x:Key="Inset.0.1.0.0">0,1,0,0</Thickness>
    <Thickness x:Key="Inset.0.12">0,12</Thickness>
    <Thickness x:Key="Inset.0.12.0.0">0,12,0,0</Thickness>
    <Thickness x:Key="Inset.0.12.16.0">0,12,16,0</Thickness>
    <Thickness x:Key="Inset.0.16.0.0">0,16,0,0</Thickness>
    <Thickness x:Key="Inset.0.22.0.0">0,22,0,0</Thickness>
    <Thickness x:Key="Inset.0.28.0.0">0,28,0,0</Thickness>
    <Thickness x:Key="Inset.0.4">0,4</Thickness>
    <Thickness x:Key="Inset.0.4.0.0">0,4,0,0</Thickness>
    <Thickness x:Key="Inset.0.8">0,8</Thickness>
    <Thickness x:Key="Inset.0.8.0.0">0,8,0,0</Thickness>
    <Thickness x:Key="Inset.12.0">12,0</Thickness>
    <Thickness x:Key="Inset.12.0.0.0">12,0,0,0</Thickness>
    <Thickness x:Key="Inset.12.0.12.0">12,0,12,0</Thickness>
    <Thickness x:Key="Inset.12.0.16.0">12,0,16,0</Thickness>
    <Thickness x:Key="Inset.12.0.22.0">12,0,22,0</Thickness>
    <Thickness x:Key="Inset.12.0.40.0">12,0,40,0</Thickness>
    <Thickness x:Key="Inset.12.12">12,12</Thickness>
    <Thickness x:Key="Inset.12.4.0.0">12,4,0,0</Thickness>
    <Thickness x:Key="Inset.12.8">12,8</Thickness>
    <Thickness x:Key="Inset.16.0">16,0</Thickness>
    <Thickness x:Key="Inset.16.0.0.0">16,0,0,0</Thickness>
    <Thickness x:Key="Inset.16.12">16,12</Thickness>
    <Thickness x:Key="Inset.16.12.12.12">16,12,12,12</Thickness>
    <Thickness x:Key="Inset.16.12.16.8">16,12,16,8</Thickness>
    <Thickness x:Key="Inset.16.12.22.12">16,12,22,12</Thickness>
    <Thickness x:Key="Inset.22.0">22,0</Thickness>
    <Thickness x:Key="Inset.22.0.16.0">22,0,16,0</Thickness>
    <Thickness x:Key="Inset.22.0.8.0">22,0,8,0</Thickness>
    <Thickness x:Key="Inset.22.12.22.12">22,12,22,12</Thickness>
    <Thickness x:Key="Inset.22.12.22.4">22,12,22,4</Thickness>
    <Thickness x:Key="Inset.22.16">22,16</Thickness>
    <Thickness x:Key="Inset.22.16.22.22">22,16,22,22</Thickness>
    <Thickness x:Key="Inset.22.22">22,22</Thickness>
    <Thickness x:Key="Inset.22.22.22.22">22,22,22,22</Thickness>
    <Thickness x:Key="Inset.4">4</Thickness>
    <Thickness x:Key="Inset.4.0.0.0">4,0,0,0</Thickness>
    <Thickness x:Key="Inset.40.22.40.28">40,22,40,28</Thickness>
    <Thickness x:Key="Inset.40.28">40,28</Thickness>
    <Thickness x:Key="Inset.40.28.40.40">40,28,40,40</Thickness>
    <Thickness x:Key="Inset.8.0.0.0">8,0,0,0</Thickness>
    <Thickness x:Key="Inset.8.4">8,4</Thickness>

    <!-- Radii -->
    <CornerRadius x:Key="Radius.Xs">2</CornerRadius>
    <CornerRadius x:Key="Radius.Sm">6</CornerRadius>
    <CornerRadius x:Key="Radius.Field">6,6,0,0</CornerRadius>
    <CornerRadius x:Key="Radius.Lg">8</CornerRadius>
    <CornerRadius x:Key="Radius.Dialog">10</CornerRadius>
    <CornerRadius x:Key="Radius.Xl">14</CornerRadius>

    <!-- Sizes -->
    <sys:Double x:Key="Size.Field">40</sys:Double>
    <sys:Double x:Key="Size.Button">40</sys:Double>
    <sys:Double x:Key="Size.ButtonSmall">36</sys:Double>
    <sys:Double x:Key="Size.Row">48</sys:Double>
    <sys:Double x:Key="Size.RowSmall">44</sys:Double>
    <sys:Double x:Key="Size.Dot">6</sys:Double>
    <sys:Double x:Key="Size.DotLarge">8</sys:Double>
    <sys:Double x:Key="Focus.Width">1.5</sys:Double>
    <Thickness x:Key="Focus.Thickness">1.5</Thickness>
    <Thickness x:Key="Focus.Outset">-3.5</Thickness>
</ResourceDictionary>
