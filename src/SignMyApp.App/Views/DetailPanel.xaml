<UserControl x:Class="SignMyApp.App.Views.DetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SignMyApp.App.Controls"
             xmlns:v="clr-namespace:SignMyApp.App.Views"
             xmlns:vm="clr-namespace:SignMyApp.App.ViewModels"
             xmlns:t="clr-namespace:SignMyApp.App.Services"
             FontFamily="{StaticResource Font.Sans}" Foreground="{StaticResource Brush.Ink}" Background="{StaticResource Brush.Bg}"
             UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <UserControl.Resources>
        <Style x:Key="Pad" TargetType="StackPanel">
            <Setter Property="Margin" Value="{StaticResource Inset.22.22.22.22}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=v:MainView}}" Value="True">
                    <Setter Property="Margin" Value="{StaticResource Inset.22.16.22.22}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Gap" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="{StaticResource Inset.0.22.0.0}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=v:MainView}}" Value="True">
                    <Setter Property="Margin" Value="{StaticResource Inset.0.16.0.0}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FactKey" TargetType="TextBlock" BasedOn="{StaticResource T.Small}">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Margin" Value="{StaticResource Inset.0.0.12.0}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=v:MainView}}" Value="True">
                    <Setter Property="Width" Value="Auto" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel Style="{StaticResource Pad}">
        <!-- File name -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="{StaticResource Radius.Sm}" Background="{StaticResource Brush.Subtle}">
                <Path Data="{StaticResource Geo.File}" Stroke="{StaticResource Brush.Ink}" StrokeThickness="1.3" StrokeLineJoin="Round" Width="16" Height="16" />
            </Border>
            <TextBlock Grid.Column="1" Style="{StaticResource T.Title}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="{StaticResource Inset.12.0.0.0}" />
        </Grid>

        <!-- One status line; the explanation waits behind Why? -->
        <StackPanel Style="{StaticResource Gap}">
            <StackPanel Orientation="Horizontal">
                <ctl:Spinner Width="14" Height="14" Margin="{StaticResource Inset.0.0.12.0}" Visibility="{Binding ShowSpinner, Converter={StaticResource BoolVis}}" />
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="{StaticResource Inset.0.0.12.0}" Fill="{Binding Tone, Converter={StaticResource ToneBrush}}"
                         Visibility="{Binding ShowDot, Converter={StaticResource BoolVis}}" />
                <TextBlock x:Name="StatusLabel" AutomationProperties.LiveSetting="Polite" ctl:LiveRegion.Text="{Binding Label}" Style="{StaticResource T.H2}" Text="{Binding Label}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Style="{StaticResource T.Body}" Margin="{StaticResource Inset.0.8.0.0}" Visibility="{Binding HasLine, Converter={StaticResource BoolVis}}">
                <Run Text="{Binding Line, Mode=OneWay}" />
                <InlineUIContainer BaselineAlignment="Baseline">
                    <Button x:Name="WhyButton" Style="{StaticResource Link.Underlined}" FontSize="{StaticResource Text.Base}" Content="{x:Static t:Text.Why}" Margin="4,0,0,-4"
                            Command="{Binding ToggleWhyCommand}" Visibility="{Binding HasWhy, Converter={StaticResource BoolVis}}"
                            AutomationProperties.HelpText="{Binding WhyText}" />
                </InlineUIContainer>
            </TextBlock>
            <Border Margin="{StaticResource Inset.0.8.0.0}" CornerRadius="{StaticResource Radius.Sm}" Background="{StaticResource Brush.Subtle}" Padding="{StaticResource Inset.12.12}"
                    Visibility="{Binding IsWhyOpen, Converter={StaticResource BoolVis}}">
                <TextBlock Style="{StaticResource T.Small}" Foreground="{StaticResource Brush.TextOnGrey}" Text="{Binding WhyText}" TextWrapping="Wrap" LineHeight="19.5" />
            </Border>
        </StackPanel>

        <!-- Installer held back: the three steps -->
        <ItemsControl Style="{StaticResource Gap}" ItemsSource="{Binding Steps}" Focusable="False" Visibility="{Binding HasSteps, Converter={StaticResource BoolVis}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:StepRow}">
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Inset.0.0.0.8}">
                        <Border x:Name="Circle" Width="20" Height="20" CornerRadius="10" Background="{StaticResource Brush.Ink}">
                            <TextBlock x:Name="Num" Text="{Binding Number}" FontSize="{StaticResource Text.Xs}" FontWeight="Bold" Foreground="{StaticResource Brush.OnInk}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="Label" Style="{StaticResource T.Small}" Text="{Binding Label}" Margin="{StaticResource Inset.12.0.0.0}" VerticalAlignment="Center" />
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static vm:StepState.Done}">
                            <Setter TargetName="Circle" Property="Background" Value="{StaticResource Brush.Status.Success}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static vm:StepState.Later}">
                            <Setter TargetName="Circle" Property="Background" Value="{StaticResource Brush.Muted}" />
                            <Setter TargetName="Num" Property="Foreground" Value="{StaticResource Brush.TextOnGrey}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Brush.TextOnGrey}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Facts and the SHA-256 -->
        <Border Style="{StaticResource Gap}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Facts}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FactRow}">
                            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="{StaticResource Inset.0.8}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource FactKey}" Text="{Binding Key}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="7*" />
                                            <ColumnDefinition Width="3*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Height="8" CornerRadius="4" Background="{StaticResource Brush.Muted}" VerticalAlignment="Center"
                                                Visibility="{Binding IsBar, Converter={StaticResource BoolVis}}" />
                                        <TextBlock Grid.ColumnSpan="2" Style="{StaticResource T.Small}" Text="{Binding Value}" TextWrapping="Wrap" LineHeight="19" />
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" MinHeight="40">
                    <DockPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource FactKey}" Text="{x:Static t:Text.Sha256}" />
                        <Button x:Name="CopyButton" DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding CopyShaCommand}"
                                AutomationProperties.Name="{x:Static t:Text.CopySha256}" ToolTip="{x:Static t:Text.Copy}">
                            <Path Data="{StaticResource Geo.Copy}" Style="{StaticResource IconPath}" StrokeThickness="1.4" />
                        </Button>
                        <TextBlock Style="{StaticResource T.Mono}" Foreground="{StaticResource Brush.TextOnGrey}" Text="{Binding ShaShort}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ><TextBlock.ToolTip><ToolTip Style="{StaticResource ToolTip.Mono}" Content="{Binding Sha256}" /></TextBlock.ToolTip></TextBlock>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Next step -->
        <Button x:Name="ActionButton" Style="{StaticResource Btn.Secondary}" HorizontalAlignment="Left" Content="{Binding ActionLabel}" Command="{Binding ActionCommand}"
                Visibility="{Binding HasAction, Converter={StaticResource BoolVis}}" Margin="{StaticResource Inset.0.22.0.0}" />
    </StackPanel>
</UserControl>
