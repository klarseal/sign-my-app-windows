<UserControl x:Class="SignMyApp.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SignMyApp.App.Controls"
             xmlns:vm="clr-namespace:SignMyApp.App.ViewModels"
             xmlns:t="clr-namespace:SignMyApp.App.Services"
             FontFamily="{StaticResource Font.Sans}" Foreground="{StaticResource Brush.Ink}" Background="{StaticResource Brush.Bg}"
             UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <UserControl.Resources>
        <Style x:Key="Toolbar" TargetType="Border">
            <Setter Property="Height" Value="60" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Height" Value="52" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="H2" TargetType="TextBlock" BasedOn="{StaticResource T.Title}" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Toolbar}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,1" Padding="{StaticResource Inset.12.0.22.0}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BackButton" AutomationProperties.Name="{x:Static t:Text.Files}" Style="{StaticResource Btn.Ghost}" Padding="{StaticResource Inset.12.0.12.0}" Command="{Binding BackCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Geo.Back}" Style="{StaticResource IconPath}" />
                        <TextBlock Text="{x:Static t:Text.Files}" Margin="{StaticResource Inset.8.0.0.0}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border Width="1" Height="20" Background="{StaticResource Brush.Border}" Margin="{StaticResource Inset.12.0}" />
                <TextBlock Style="{StaticResource T.Title}" Text="{x:Static t:Text.Settings}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="{StaticResource Inset.40.28.40.40}" Width="560" DataContext="{Binding Settings}">

                <!-- Always for this project -->
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="{x:Static t:Text.TrustHeading}" />
                    <TextBlock Style="{StaticResource T.Small}" Foreground="{StaticResource Brush.TextBody}" Text="{x:Static t:Text.TrustLine}" Margin="{StaticResource Inset.0.4.0.0}" />
                    <ItemsControl ItemsSource="{Binding TrustRows}" Focusable="False" Margin="{StaticResource Inset.0.12.0.0}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TrustRowViewModel}">
                                <Grid Margin="{StaticResource Inset.0.0.0.8}">
                                    <!-- Idle: folder, publisher · source, Forget -->
                                    <Border CornerRadius="{StaticResource Radius.Sm}" Background="{StaticResource Brush.Subtle}" Padding="{StaticResource Inset.16.12.12.12}"
                                            Visibility="{Binding IsIdle, Converter={StaticResource BoolVis}}">
                                        <DockPanel>
                                            <Button x:Name="ForgetButton" DockPanel.Dock="Right" Style="{StaticResource Btn.White}" Height="36" Padding="{StaticResource Inset.16.0}" FontSize="{StaticResource Text.Sm}"
                                                    Content="{x:Static t:Text.Forget}" Command="{Binding AskCommand}" Margin="{StaticResource Inset.16.0.0.0}" VerticalAlignment="Center"
                                                    AutomationProperties.Name="{Binding ForgetAutomationName}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Folder}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Text.Sm}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Line}" Style="{StaticResource T.Meta}" Margin="{StaticResource Inset.0.4.0.0}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <!-- Confirm: Forget D:\work\Tools? Keep (focused) / Forget -->
                                    <Border CornerRadius="{StaticResource Radius.Sm}" Background="{StaticResource Brush.Muted}" Padding="{StaticResource Inset.16.12.12.12}" MinHeight="56"
                                            Visibility="{Binding IsConfirming, Converter={StaticResource BoolVis}}"
                                            AutomationProperties.Name="{Binding GroupLabel}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="{StaticResource Inset.16.0.0.0}" VerticalAlignment="Center">
                                                <Button x:Name="KeepButton" Style="{StaticResource Btn.White}" Height="36" Padding="{StaticResource Inset.16.0}" FontSize="{StaticResource Text.Sm}"
                                                        AutomationProperties.Name="{Binding KeepAutomationName}" Content="{x:Static t:Text.Keep}" Command="{Binding KeepCommand}" Loaded="OnKeepLoaded" IsVisibleChanged="OnKeepVisibleChanged" />
                                                <Button Style="{StaticResource Btn.Primary}" Height="36" Padding="{StaticResource Inset.16.0}" FontSize="{StaticResource Text.Sm}"
                                                        AutomationProperties.Name="{Binding ForgetAutomationName}" Content="{x:Static t:Text.Forget}" Command="{Binding ForgetCommand}" Margin="{StaticResource Inset.8.0.0.0}" />
                                            </StackPanel>
                                            <TextBlock VerticalAlignment="Center" FontSize="{StaticResource Text.Base}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                <Run Text="{x:Static t:Text.Forget}" /><Run Text=" " /><Run Text="{Binding Folder, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Text.Sm}" FontWeight="Normal" /><Run Text="?" />
                                            </TextBlock>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Timestamp server -->
                <StackPanel Margin="{StaticResource Inset.0.22.0.0}">
                    <TextBlock Style="{StaticResource H2}" Text="{x:Static t:Text.TimestampServer}" />
                    <DockPanel Margin="{StaticResource Inset.0.12.0.0}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Padding="{StaticResource Inset.16.0}" Content="{x:Static t:Text.UseDefault}" Command="{Binding UseDefaultCommand}" Margin="{StaticResource Inset.12.0.0.0}" />
                        <TextBox x:Name="TimestampBox" Style="{StaticResource Field}" Text="{Binding TimestampUrl, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.HelpText="{Binding TimestampError}" AutomationProperties.ItemStatus="{Binding TimestampError}" Tag="{Binding IsTimestampInvalid}" AutomationProperties.Name="{x:Static t:Text.TimestampServerAddress}" />
                    </DockPanel>
                    <TextBlock x:Name="TimestampError" AutomationProperties.LiveSetting="Polite" ctl:LiveRegion.Text="{Binding TimestampError}" Text="{Binding TimestampError}" FontSize="{StaticResource Text.Xs}" Foreground="{StaticResource Brush.Status.Danger}" Margin="{StaticResource Inset.0.8.0.0}"
                               Visibility="{Binding IsTimestampInvalid, Converter={StaticResource BoolVis}}" />
                </StackPanel>

                <!-- Language -->
                <StackPanel Margin="{StaticResource Inset.0.28.0.0}">
                    <TextBlock Style="{StaticResource H2}" Text="{x:Static t:Text.Language}" />
                    <ComboBox x:Name="LanguageBox" TextSearch.TextPath="Name" Style="{StaticResource FieldSelect}" Width="280" HorizontalAlignment="Left" Margin="{StaticResource Inset.0.12.0.0}"
                              ItemsSource="{Binding Languages}" SelectedItem="{Binding Language, Mode=TwoWay}"
                              AutomationProperties.Name="{x:Static t:Text.Language}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LanguageOption}">
                                <TextBlock Text="{Binding Name}" AutomationProperties.Name="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="{StaticResource Inset.0.16.0.0}" Margin="{StaticResource Inset.0.28.0.0}">
                    <TextBlock Style="{StaticResource T.Meta}" Text="{Binding VersionLine}" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
