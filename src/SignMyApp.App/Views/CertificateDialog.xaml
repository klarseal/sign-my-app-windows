<UserControl x:Class="SignMyApp.App.Views.CertificateDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SignMyApp.App.ViewModels"
             xmlns:t="clr-namespace:SignMyApp.App.Services"
             FontFamily="{StaticResource Font.Sans}" Foreground="{StaticResource Brush.Ink}"
             UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
             KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"
             AutomationProperties.Name="{x:Static t:Text.ChooseCertificate}">
    <Grid>
    <Border CornerRadius="{StaticResource Radius.Dialog}" Background="{StaticResource Brush.Bg}">
        <Border.Effect>
            <DropShadowEffect Color="{StaticResource Color.Shadow}" BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.12" />
        </Border.Effect>
    </Border>
    <Border CornerRadius="{StaticResource Radius.Dialog}" Background="{StaticResource Brush.Bg}" ClipToBounds="False">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border MinHeight="44" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="{StaticResource Inset.22.0.8.0}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.IconSmall}" Command="{Binding CancelCommand}"
                            AutomationProperties.Name="{x:Static t:Text.Close}" ToolTip="{x:Static t:Text.Close}">
                        <Path Data="{StaticResource Geo.Close}" Style="{StaticResource IconPath}" StrokeThickness="1.4" Width="12" Height="12" LayoutTransform="{x:Null}" />
                    </Button>
                    <TextBlock Text="{x:Static t:Text.ChooseCertificate}" FontSize="{StaticResource Text.Base}" FontWeight="Bold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="{StaticResource Inset.22.22}">
                    <!-- Several / expired: the certificates on this PC -->
                    <StackPanel Visibility="{Binding ShowList, Converter={StaticResource BoolVis}}" Margin="{StaticResource Inset.0.0.0.12}">
                        <ItemsControl x:Name="CertList" KeyboardNavigation.TabNavigation="Once" ItemsSource="{Binding Rows}" Focusable="False" KeyboardNavigation.DirectionalNavigation="Contained"
                                      AutomationProperties.Name="{x:Static t:Text.CertificatesOnThisPc}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CertificateRowViewModel}">
                                    <RadioButton Style="{StaticResource CertRow}" GroupName="cert" GotKeyboardFocus="OnRowFocus" PreviewKeyDown="OnRowKeyDown" Margin="{StaticResource Inset.0.0.0.8}"
                                                 IsChecked="{Binding IsSelected, Mode=OneWay}" IsEnabled="{Binding IsUsable}"
                                                 Command="{Binding DataContext.SelectRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                 AutomationProperties.Name="{Binding Name}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource T.Mono}" Text="{Binding ThumbShort}"
                                                       VerticalAlignment="Center" Margin="{StaticResource Inset.12.0.0.0}" ><TextBlock.ToolTip><ToolTip Style="{StaticResource ToolTip.Mono}" Content="{Binding ThumbTooltip}" /></TextBlock.ToolTip></TextBlock>
                                            <StackPanel>
                                                <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="{StaticResource Text.Row}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Margin="{StaticResource Inset.0.4.0.0}">
                                                    <Ellipse Style="{StaticResource Dot}" Fill="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                                                    <TextBlock Text="{Binding ValidText}" FontSize="{StaticResource Text.Sm}" Foreground="{StaticResource Brush.TextOnGrey}" Margin="{StaticResource Inset.8.0.0.0}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding SourceText}" FontSize="{StaticResource Text.Sm}" Foreground="{StaticResource Brush.TextMuted}" Margin="{StaticResource Inset.4.0.0.0}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </RadioButton>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsUsable}" Value="False">
                                            <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource T.Body}" Foreground="{StaticResource Brush.Ink}" Margin="{StaticResource Inset.0.8.0.0}"
                                   Visibility="{Binding IsExpired, Converter={StaticResource BoolVis}}">
                            <Run Text="{x:Static t:Text.TimestampedFilesKeepWorking}" />
                            <InlineUIContainer BaselineAlignment="Baseline">
                                <Button Style="{StaticResource Link.Underlined}" FontSize="{StaticResource Text.Base}" Content="{x:Static t:Text.GetNewCertificate}" Margin="2,0,0,-4"
                                        Command="{Binding OpenGetCertificateCommand}" />
                            </InlineUIContainer>
                        </TextBlock>
                    </StackPanel>

                    <!-- None found -->
                    <StackPanel Visibility="{Binding IsNone, Converter={StaticResource BoolVis}}" Margin="{StaticResource Inset.0.0.0.12}">
                        <TextBlock Text="{x:Static t:Text.NoCertificateFound}" FontSize="{StaticResource Text.Dialog}" FontWeight="Bold" />
                        <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Margin="{StaticResource Inset.0.12.0.0}">
                            <StackPanel>
                                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="{StaticResource Inset.0.12}">
                                    <DockPanel>
                                        <TextBlock Margin="{StaticResource Inset.0.0.12.0}" FontSize="{StaticResource Text.Sm}" FontWeight="SemiBold" Text="{x:Static t:Text.SimplySign}" />
                                        <TextBlock FontSize="{StaticResource Text.Sm}" Foreground="{StaticResource Brush.TextOnGrey}" Text="{x:Static t:Text.LogInToSimplySignDesktop}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </Border>
                                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="{StaticResource Inset.0.12}">
                                    <DockPanel>
                                        <TextBlock Margin="{StaticResource Inset.0.0.12.0}" FontSize="{StaticResource Text.Sm}" FontWeight="SemiBold" Text="{x:Static t:Text.UsbToken}" />
                                        <TextBlock FontSize="{StaticResource Text.Sm}" Foreground="{StaticResource Brush.TextOnGrey}" Text="{x:Static t:Text.PlugItIn}" />
                                    </DockPanel>
                                </Border>
                                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="{StaticResource Inset.0.12}">
                                    <DockPanel>
                                        <TextBlock Margin="{StaticResource Inset.0.0.12.0}" FontSize="{StaticResource Text.Sm}" FontWeight="SemiBold" Text="{x:Static t:Text.CertificateStore}" />
                                        <TextBlock FontSize="{StaticResource Text.Sm}" Foreground="{StaticResource Brush.TextOnGrey}" Text="{x:Static t:Text.ImportIt}" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource Link.Plain}" AutomationProperties.Name="Get a certificate, opens in browser" Content="{x:Static t:Text.GetCertificate}" Command="{Binding OpenGetCertificateCommand}" Margin="{StaticResource Inset.0.12.0.0}" />
                    </StackPanel>

                    <!-- SimplySign Desktop logged out -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsLoggedOut, Converter={StaticResource BoolVis}}" Margin="{StaticResource Inset.0.0.0.12}">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Status.Action}" VerticalAlignment="Center" Margin="{StaticResource Inset.0.0.12.0}" />
                        <TextBlock Text="{x:Static t:Text.LogInThenRefresh}" FontSize="{StaticResource Text.Dialog}" FontWeight="Bold" TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource T.Meta}" Text="{x:Static t:Text.NeverAskSecrets}" />
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <Border Grid.Row="2" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="{StaticResource Inset.16.12.22.12}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="CancelButton" Style="{StaticResource Btn.Secondary}" Content="{x:Static t:Text.Cancel}" Command="{Binding CancelCommand}" />
                        <Button x:Name="UseButton" Style="{StaticResource Btn.Primary}" Content="{x:Static t:Text.UseThisCertificate}" Command="{Binding UseCommand}" Margin="{StaticResource Inset.8.0.0.0}"
                                Visibility="{Binding ShowUse, Converter={StaticResource BoolVis}}" />
                        <Button x:Name="RefreshPrimary" Style="{StaticResource Btn.Primary}" AutomationProperties.Name="{Binding RefreshLabel}" Command="{Binding RefreshCommand}" Margin="{StaticResource Inset.8.0.0.0}"
                                Visibility="{Binding ShowRefreshPrimary, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Geo.Refresh}" Style="{StaticResource IconPath}" />
                                <TextBlock Text="{Binding RefreshLabel}" Margin="{StaticResource Inset.8.0.0.0}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Button x:Name="RefreshGhost" Style="{StaticResource Btn.Ghost}" AutomationProperties.Name="{Binding RefreshLabel}" Command="{Binding RefreshCommand}" HorizontalAlignment="Left"
                            Visibility="{Binding ShowRefreshGhost, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Geo.Refresh}" Style="{StaticResource IconPath}" />
                            <TextBlock Text="{Binding RefreshLabel}" Margin="{StaticResource Inset.8.0.0.0}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
    </Grid>
</UserControl>
