<UserControl x:Class="SignMyApp.App.Views.SignDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SignMyApp.App.Controls"
             xmlns:vm="clr-namespace:SignMyApp.App.ViewModels"
             xmlns:t="clr-namespace:SignMyApp.App.Services"
             FontFamily="{StaticResource Font.Sans}" Foreground="{StaticResource Brush.Ink}"
             UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
             KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"
             AutomationProperties.Name="{Binding Title}">
    <UserControl.Resources>
        <!-- One file in the review: name and short SHA-256; full SHA-256 on demand; a state while signing -->
        <DataTemplate x:Key="SignFileRow" DataType="{x:Type vm:SignFileRowViewModel}">
            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="{StaticResource Inset.0.8}" MinHeight="40">
                <StackPanel VerticalAlignment="Center">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="{StaticResource Inset.12.0.0.0}">
                            <TextBlock Style="{StaticResource T.Mono}" Text="{Binding ShaShort}" VerticalAlignment="Center"
                                       Visibility="{Binding ShowShortSha, Converter={StaticResource BoolVis}}" ><TextBlock.ToolTip><ToolTip Style="{StaticResource ToolTip.Mono}" Content="{Binding Sha}" /></TextBlock.ToolTip></TextBlock>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasState, Converter={StaticResource BoolVis}}">
                                <ctl:Spinner Margin="{StaticResource Inset.0.0.8.0}" Visibility="{Binding Spin, Converter={StaticResource BoolVis}}" />
                                <Ellipse Style="{StaticResource Dot}" Margin="{StaticResource Inset.0.0.8.0}" Fill="{Binding Tone, Converter={StaticResource ToneBrush}}"
                                         Visibility="{Binding ShowDot, Converter={StaticResource BoolVis}}" />
                                <TextBlock Text="{Binding StateText}" FontSize="{StaticResource Text.Sm}" Foreground="{StaticResource Brush.TextOnGrey}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="{StaticResource Text.Base}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource T.Mono}" Text="{Binding Sha}" TextWrapping="Wrap" LineHeight="18" Margin="{StaticResource Inset.0.4.0.0}"
                               Visibility="{Binding ShowFullSha, Converter={StaticResource BoolVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AppFileRow" DataType="{x:Type vm:SignFileRowViewModel}">
            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="{StaticResource Inset.0.4}" MinHeight="36">
                <StackPanel VerticalAlignment="Center">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource T.Mono}" Text="{Binding ShaShort}" Margin="{StaticResource Inset.12.0.0.0}" VerticalAlignment="Center"
                                   Visibility="{Binding ShowShortSha, Converter={StaticResource BoolVis}}" ><TextBlock.ToolTip><ToolTip Style="{StaticResource ToolTip.Mono}" Content="{Binding Sha}" /></TextBlock.ToolTip></TextBlock>
                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource Text.Sm}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource T.Mono}" Text="{Binding Sha}" TextWrapping="Wrap" LineHeight="18" Margin="{StaticResource Inset.0.4.0.0}"
                               Visibility="{Binding ShowFullSha, Converter={StaticResource BoolVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="StepCircle" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{StaticResource Brush.Muted}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.TextOnGrey}" />
            <Setter Property="TextElement.FontSize" Value="{StaticResource Text.Xs}" />
            <Setter Property="TextElement.FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="Bar" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="2" Background="{StaticResource Brush.Muted}" />
                            <Border x:Name="PART_Indicator" CornerRadius="2" Background="{StaticResource Brush.Ink}" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border CornerRadius="{StaticResource Radius.Dialog}" Background="{StaticResource Brush.Bg}">
            <Border.Effect>
                <DropShadowEffect Color="{StaticResource Color.Shadow}" BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.12" />
            </Border.Effect>
        </Border>
        <Border CornerRadius="{StaticResource Radius.Dialog}" Background="{StaticResource Brush.Bg}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Border MinHeight="44" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="{StaticResource Inset.22.0.8.0}">
                    <DockPanel>
                        <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource Btn.IconSmall}" Command="{Binding CancelCommand}"
                                AutomationProperties.Name="{x:Static t:Text.Close}" ToolTip="{x:Static t:Text.Close}">
                            <Path Data="{StaticResource Geo.Close}" Style="{StaticResource IconPath}" StrokeThickness="1.4" Width="12" Height="12" LayoutTransform="{x:Null}" />
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path x:Name="KlarsealMark" Data="{StaticResource Geo.KlarsealMark}" Fill="{StaticResource Brush.Ink}"
                                  Width="7" Height="17" Stretch="Uniform" Margin="0,0,9,0" IsHitTestVisible="False"
                                  UseLayoutRounding="False" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static t:Text.Sign}" FontSize="{StaticResource Text.Base}" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Body: scrolls in the small window -->
                <ScrollViewer x:Name="Body" Grid.Row="1" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="{StaticResource Inset.22.22.22.22}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="{StaticResource Inset.0.0.12.0}" Fill="{Binding HeadTone, Converter={StaticResource ToneBrush}}"
                                         Visibility="{Binding HasHeadDot, Converter={StaticResource BoolVis}}" />
                                <TextBlock x:Name="TitleText" AutomationProperties.LiveSetting="Polite" ctl:LiveRegion.Text="{Binding Title}" Style="{StaticResource T.H2}" Text="{Binding Title}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource T.Body}" Foreground="{StaticResource Brush.TextOnGrey}" Text="{Binding Line}" Margin="{StaticResource Inset.0.4.0.0}"
                                       Visibility="{Binding HasLine, Converter={StaticResource BoolVis}}" />
                        </StackPanel>

                        <ProgressBar Style="{StaticResource Bar}" Value="{Binding ProgressValue, Mode=OneWay}" Margin="{StaticResource Inset.0.16.0.0}"
                                     AutomationProperties.Name="{x:Static t:Text.SigningProgress}"
                                     Visibility="{Binding IsProgress, Converter={StaticResource BoolVis}}" />

                        <!-- Installer order: app files now, rebuild, sign the installer last -->
                        <StackPanel Margin="{StaticResource Inset.0.16.0.0}" Visibility="{Binding IsInstaller, Converter={StaticResource BoolVis}}">
                            <DockPanel>
                                <Border Style="{StaticResource StepCircle}" Background="{StaticResource Brush.Ink}" TextElement.Foreground="{StaticResource Brush.OnInk}">
                                    <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="{StaticResource Inset.12.4.0.0}">
                                    <TextBlock Text="{Binding Step1}" FontSize="{StaticResource Text.Base}" FontWeight="Bold" />
                                    <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Margin="{StaticResource Inset.0.8.0.0}">
                                        <ItemsControl ItemsSource="{Binding AppRows}" ItemTemplate="{StaticResource AppFileRow}" Focusable="False" />
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="{StaticResource Inset.0.12.0.0}">
                                <Border Style="{StaticResource StepCircle}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <TextBlock Text="{Binding Step2}" FontSize="{StaticResource Text.Base}" FontWeight="SemiBold" Margin="{StaticResource Inset.12.0.0.0}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="{StaticResource Inset.0.12.0.0}">
                                <Border Style="{StaticResource StepCircle}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <TextBlock Text="{Binding Step3}" FontSize="{StaticResource Text.Base}" FontWeight="SemiBold" Margin="{StaticResource Inset.12.0.0.0}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Files -->
                        <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Margin="{StaticResource Inset.0.16.0.0}"
                                Visibility="{Binding ShowFiles, Converter={StaticResource BoolVis}}">
                            <ItemsControl ItemsSource="{Binding Files}" ItemTemplate="{StaticResource SignFileRow}" Focusable="False" />
                        </Border>

                        <Button x:Name="FullToggle" Style="{StaticResource Link.Underlined}" MinHeight="32" Margin="{StaticResource Inset.0.8.0.0}" Content="{Binding FullLabel}" Command="{Binding ToggleFullCommand}"
                                Visibility="{Binding CanToggleFull, Converter={StaticResource BoolVis}}" />

                        <!-- What will be used -->
                        <Border CornerRadius="{StaticResource Radius.Sm}" Background="{StaticResource Brush.Subtle}" Padding="{StaticResource Inset.16.12.16.8}" Margin="{StaticResource Inset.0.8.0.0}"
                                Visibility="{Binding ShowDetails, Converter={StaticResource BoolVis}}">
                            <ItemsControl ItemsSource="{Binding Details}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DetailLine}">
                                        <DockPanel Margin="{StaticResource Inset.0.0.0.8}">
                                            <TextBlock Margin="{StaticResource Inset.0.0.12.0}" FontSize="{StaticResource Text.Sm}" Foreground="{StaticResource Brush.TextMuted}" Text="{Binding Key}" />
                                            <TextBlock x:Name="Value" FontSize="{StaticResource Text.Sm}" Text="{Binding Value}" TextWrapping="Wrap" />
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsMono}" Value="True">
                                                <Setter TargetName="Value" Property="FontFamily" Value="{StaticResource Font.Mono}" />
                                                <Setter TargetName="Value" Property="FontSize" Value="{StaticResource Text.Xs}" />
                                                <Setter TargetName="Value" Property="VerticalAlignment" Value="Center" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- Errors: one fix -->
                        <Border CornerRadius="{StaticResource Radius.Sm}" Background="{StaticResource Brush.Subtle}" Padding="{StaticResource Inset.12.12}" Margin="{StaticResource Inset.0.16.0.0}"
                                Visibility="{Binding HasFix, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding Fix}" FontSize="{StaticResource Text.Base}" TextWrapping="Wrap" LineHeight="20" />
                        </Border>

                        <!-- What does Always do? -->
                        <StackPanel Margin="{StaticResource Inset.0.16.0.0}" Visibility="{Binding IsReviewing, Converter={StaticResource BoolVis}}">
                            <Button x:Name="AlwaysToggle" Style="{StaticResource Link.Underlined}" MinHeight="32" Content="{x:Static t:Text.WhatDoesAlwaysDo}" Command="{Binding ToggleAlwaysCommand}" />
                            <Border x:Name="AlwaysExplanation" CornerRadius="{StaticResource Radius.Sm}" Background="{StaticResource Brush.Subtle}" Padding="{StaticResource Inset.12.12}" Margin="{StaticResource Inset.0.8.0.0}"
                                    Visibility="{Binding AlwaysOpen, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{x:Static t:Text.AlwaysExplained}" FontSize="{StaticResource Text.Sm}" Foreground="{StaticResource Brush.TextOnGrey}" TextWrapping="Wrap" LineHeight="19.5" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Buttons: Cancel / Sign once / Always for this project. Cancel has focus. -->
                <Border Grid.Row="2" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="{StaticResource Inset.22.12.22.12}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsReviewing, Converter={StaticResource BoolVis}}">
                                <Button x:Name="CancelButton" Style="{StaticResource Btn.Secondary}" Content="{x:Static t:Text.Cancel}" Command="{Binding CancelCommand}" />
                                <Button x:Name="SignOnceButton" Style="{StaticResource Btn.Primary}" Content="{x:Static t:Text.SignOnce}" Command="{Binding SignOnceCommand}" Margin="{StaticResource Inset.8.0.0.0}" />
                                <Button x:Name="AlwaysButton" Style="{StaticResource Btn.Secondary}" Content="{x:Static t:Text.AlwaysForThisProject}" Command="{Binding AlwaysCommand}" Margin="{StaticResource Inset.8.0.0.0}" />
                            </StackPanel>
                            <Button x:Name="StopButton" Style="{StaticResource Btn.Secondary}" Content="{x:Static t:Text.StopAfterThisFile}" Command="{Binding StopCommand}"
                                    Visibility="{Binding IsProgress, Converter={StaticResource BoolVis}}" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsDone, Converter={StaticResource BoolVis}}">
                                <Button Style="{StaticResource Btn.Secondary}" Content="{x:Static t:Text.ShowInFolder}" Command="{Binding ShowInFolderCommand}" />
                                <Button x:Name="BackButton" Style="{StaticResource Btn.Primary}" Content="{x:Static t:Text.BackToFiles}" Command="{Binding BackToFilesCommand}" Margin="{StaticResource Inset.8.0.0.0}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsError, Converter={StaticResource BoolVis}}">
                                <Button x:Name="ErrorSecondary" Style="{StaticResource Btn.Secondary}" Content="{Binding ErrorSecondaryLabel}" Command="{Binding CancelCommand}" />
                                <Button x:Name="ErrorPrimary" Style="{StaticResource Btn.Primary}" Content="{Binding ErrorPrimaryLabel}" Command="{Binding ErrorPrimaryCommand}" Margin="{StaticResource Inset.8.0.0.0}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="StatusText" AutomationProperties.LiveSetting="Polite" ctl:LiveRegion.Text="{Binding Status}" Text="{Binding Status}" FontSize="{StaticResource Text.Sm}" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="{StaticResource Inset.0.0.16.0}" />
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
